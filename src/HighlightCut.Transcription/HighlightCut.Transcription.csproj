<Project Sdk="Microsoft.NET.Sdk">
  <!-- Local speech-to-text: model downloads and the engines. No UI dependencies. -->
  <PropertyGroup>
    <RootNamespace>HighlightCut.Transcription</RootNamespace>
    <!-- LowPriority calls setpriority on Linux. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HighlightCut.Core\HighlightCut.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpZipLib" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HighlightCut.Transcription.Tests" />
  </ItemGroup>
</Project>
