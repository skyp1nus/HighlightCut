<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:HighlightCut.App.Controls"
        xmlns:vm="using:HighlightCut.App.ViewModels">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://HighlightCut/Theme/Tokens.axaml" />
        <ResourceInclude Source="avares://HighlightCut/Theme/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- A bare button: every look below is a style class on top of it. -->
      <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
          <Setter Property="Cursor" Value="Arrow" />
        </Style>
      </ControlTheme>

      <!-- Square checkbox: 16 px in the clip list, 15 px (class "small") in dialogs. -->
      <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel Orientation="Horizontal" Spacing="9" Background="Transparent">
              <Border Name="box" Width="16" Height="16" CornerRadius="4" BorderThickness="1.5"
                      BorderBrush="#5C5D5E" Background="Transparent" VerticalAlignment="Center">
                <c:SvgIcon Name="tick" Data="{StaticResource IconCheck}" StrokeWidth="3.5"
                           Width="10" Height="10" Foreground="#000000" IsVisible="False" />
              </Border>
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                VerticalAlignment="Center" IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Border#box">
          <Setter Property="Background" Value="#CECECF" />
          <Setter Property="BorderBrush" Value="#CECECF" />
        </Style>
        <Style Selector="^:checked /template/ c|SvgIcon#tick">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^.small /template/ Border#box">
          <Setter Property="Width" Value="15" />
          <Setter Property="Height" Value="15" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.4" />
          <Setter Property="Cursor" Value="Arrow" />
        </Style>
      </ControlTheme>

      <!-- Chrome-style range input (accent-color #cececf): zoom and volume. -->
      <ControlTheme x:Key="ZoomSlider" TargetType="Slider">
        <Setter Property="Height" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid>
              <Border Height="4" CornerRadius="2" Background="#3A3B3D" VerticalAlignment="Center" Margin="0" />
              <Track Name="PART_Track" Orientation="Horizontal"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_DecreaseButton" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate>
                        <Border Height="4" Margin="0,0,-7,0" CornerRadius="2,0,0,2" Background="#CECECF"
                                VerticalAlignment="Center" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_IncreaseButton" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate>
                        <Border Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseButton>
                <Thumb Name="thumb" Width="14" Height="14">
                  <Thumb.Template>
                    <ControlTemplate>
                      <Ellipse Width="14" Height="14" Fill="#CECECF" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- Volume: 3 px track, light fill, 10 px white knob. -->
      <ControlTheme x:Key="VolumeSlider" TargetType="Slider">
        <Setter Property="Height" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid>
              <Border Height="3" CornerRadius="2" Background="#404040" VerticalAlignment="Center" />
              <!-- The knob is centred on the value (CSS left: n%), so the track overhangs by half a knob. -->
              <Track Name="PART_Track" Orientation="Horizontal" Margin="-5,0"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_DecreaseButton" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate>
                        <Border Height="3" Margin="5,0,-5,0" CornerRadius="2" Background="#C5C5C5" VerticalAlignment="Center" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_IncreaseButton" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate>
                        <Border Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseButton>
                <Thumb Name="thumb" Width="10" Height="10">
                  <Thumb.Template>
                    <ControlTemplate>
                      <Ellipse Width="10" Height="10" Fill="#FFFFFF" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <!--
        Pill switch (include in output, snap to keyframes): a CheckBox with this theme.
        Off: charcoal track, steel knob. On: 30 % white track, white knob. Knob = height − 4.
      -->
      <ControlTheme x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{StaticResource FieldBrush}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="track" Background="{TemplateBinding Background}" CornerRadius="7">
              <Ellipse Name="knob" Width="10" Height="10" Fill="#71717A" HorizontalAlignment="Left" Margin="2,0,0,0"
                       VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Border#track">
          <Setter Property="Background" Value="#4DFFFFFF" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#knob">
          <Setter Property="Fill" Value="#FFFFFF" />
          <Setter Property="HorizontalAlignment" Value="Right" />
          <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
        <Style Selector="^.small">
          <Setter Property="Width" Value="22" />
          <Setter Property="Height" Value="12" />
        </Style>
        <Style Selector="^.small /template/ Border#track">
          <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="^.small /template/ Ellipse#knob">
          <Setter Property="Width" Value="8" />
          <Setter Property="Height" Value="8" />
          <Setter Property="Fill" Value="#FFFFFF" />
        </Style>
      </ControlTheme>

      <!-- Settings switch with its label (Content): 28 × 16 track, 12 px knob, 10 px gap, no hover. -->
      <ControlTheme x:Key="SettingSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel Orientation="Horizontal" Spacing="10" Background="Transparent">
              <Border Name="track" Width="28" Height="16" CornerRadius="8" Background="{StaticResource FieldBrush}" VerticalAlignment="Center">
                <Ellipse Name="knob" Width="12" Height="12" Fill="#71717A" HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center" />
              </Border>
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
            </StackPanel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Border#track">
          <Setter Property="Background" Value="#4DFFFFFF" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#knob">
          <Setter Property="Fill" Value="#FFFFFF" />
          <Setter Property="HorizontalAlignment" Value="Right" />
          <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
      </ControlTheme>

      <!-- Segmented control over ChoiceOptions: <Border Classes="segs"><ItemsControl ItemsPanel=SegPanel ItemTemplate=SegItem /></Border>. -->
      <ItemsPanelTemplate x:Key="SegPanel">
        <StackPanel Orientation="Horizontal" Spacing="2" />
      </ItemsPanelTemplate>
      <DataTemplate x:Key="SegItem" x:DataType="vm:ChoiceOption">
        <Button Classes="seg" Classes.on="{Binding IsSelected}" Height="26" Padding="12,0" Content="{Binding Label}"
                Command="{Binding PickCommand}" />
      </DataTemplate>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Text defaults. -->
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>

  <!-- Keyboard hint chip, e.g. "Ctrl O": hairline outline, mono 10 px. -->
  <Style Selector="Border.kbd">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderBrush" Value="{StaticResource KbdBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.kbd.plain">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.kbd.small">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Border.kbd.status">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Height" Value="14" />
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
  </Style>
  <Style Selector="Border.kbd > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource Text4Brush}" />
  </Style>
  <Style Selector="Border.kbd.status > TextBlock">
    <Setter Property="FontSize" Value="9.5" />
  </Style>
  <!-- Shortcut chip in Settings (Keyboard rows, Playback "Shift ←"): 18 px, 10.5 px. -->
  <Style Selector="Border.kbd.key">
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="6,0" />
  </Style>
  <Style Selector="Border.kbd.key > TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
  </Style>

  <!-- Soft ghost button: 5 % white, 9 % on hover (Open file, Set in, Browse, Cancel…). -->
  <Style Selector="Button.soft">
    <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.soft:pointerover">
    <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.soft.risky:pointerover">
    <Setter Property="Background" Value="{StaticResource DangerHoverBgBrush}" />
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
  </Style>
  <Style Selector="Button.soft:disabled">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <!-- Destructive text button (Delete model). -->
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
  </Style>
  <Style Selector="Button.danger:pointerover">
    <Setter Property="Background" Value="{StaticResource DangerHoverBgBrush}" />
  </Style>

  <!-- Link-styled button. -->
  <Style Selector="Button.link">
    <Setter Property="Foreground" Value="{StaticResource LinkBrush}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.link:pointerover">
    <Setter Property="Foreground" Value="{StaticResource LinkHoverBrush}" />
  </Style>

  <!-- Segmented option / tool: selected gets 8 % white and a blue hairline ring. -->
  <Style Selector="Button.seg">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Text4Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.seg:pointerover">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.seg.on">
    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="#D93B82F6" />
  </Style>
  <!-- Track of a segmented control. -->
  <Style Selector="Border.segs">
    <Setter Property="Padding" Value="2" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{StaticResource WindowBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <!-- Title bar menu items (kept for menus that still use them). -->
  <Style Selector="Button.menu">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="Button.menu:pointerover">
    <Setter Property="Background" Value="{StaticResource SubtleHoverBrush}" />
  </Style>

  <!-- Older names, restyled as soft ghost buttons. -->
  <Style Selector="Button.control">
    <Setter Property="Height" Value="28" />
    <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.control:pointerover">
    <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
  </Style>
  <Style Selector="Button.outline">
    <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
  </Style>
  <Style Selector="Button.outline.strong">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.outline:pointerover">
    <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
  </Style>

  <!-- Icon-only ghost button: transparent, 6 % white on hover. -->
  <Style Selector="Button.ghost">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.ghost:pointerover">
    <Setter Property="Background" Value="{StaticResource SubtleHoverBrush}" />
  </Style>
  <Style Selector="Button.ghost.bright:pointerover">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.ghost.risky">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="Button.ghost.risky:pointerover">
    <Setter Property="Background" Value="{StaticResource DangerHoverBgBrush}" />
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
  </Style>

  <!-- Bone pill: Export is the only one. "primary" is the old name. -->
  <Style Selector="Button.bone, Button.primary">
    <Setter Property="Background" Value="{StaticResource BoneBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.bone:pointerover, Button.primary:pointerover">
    <Setter Property="Background" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.bone:disabled, Button.primary:disabled">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <!-- Round play button. -->
  <Style Selector="Button.white">
    <Setter Property="Background" Value="#12FFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.white:pointerover">
    <Setter Property="Background" Value="#1FFFFFFF" />
  </Style>

  <!-- Window caption buttons. -->
  <Style Selector="Button.caption">
    <Setter Property="Width" Value="46" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Text4Brush}" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="Button.caption:pointerover">
    <Setter Property="Background" Value="{StaticResource SubtleHoverBrush}" />
  </Style>
  <Style Selector="Button.caption.close:pointerover">
    <Setter Property="Background" Value="#C42B1C" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- Dropdowns and text fields: charcoal fill, hairline border, blue focus ring. -->
  <Style Selector="ComboBox.field">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,0,0,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox.field.small">
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,0,0,0" />
  </Style>
  <Style Selector="ComboBox.field:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{StaticResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource OutlineStrongBrush}" />
  </Style>
  <Style Selector="ComboBox.field:focus-visible /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{StaticResource FocusRingBrush}" />
  </Style>
  <Style Selector="Border.field">
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="{StaticResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.field > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Thin scrollbars (#484848 thumb). -->
  <Style Selector="ScrollBar">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="#484848" />
  </Style>

  <!-- Text input without chrome (Claude composer). -->
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="PlaceholderForeground" Value="{StaticResource Muted2Brush}" />
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.bare /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Editable field (File name pattern): Border.field's look, white mono text, blue focus ring. -->
  <Style Selector="TextBox.field">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SelectionBrush" Value="#553B82F6" />
  </Style>
  <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
  </Style>
  <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource OutlineStrongBrush}" />
  </Style>
  <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FocusRingBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>

  <!-- Search box: room on the left for an IconSearch12 laid over it (Keyboard, Transcript). -->
  <Style Selector="TextBox.search">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="30,0,10,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="PlaceholderForeground" Value="{StaticResource Muted2Brush}" />
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
  </Style>
  <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FocusRingBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>

  <!-- Pattern token chip ({project}, {n}…). -->
  <Style Selector="Button.token">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SelectedBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.token:pointerover">
    <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <!-- Settings: helper text under a control, and group headers ("Cache", "Permissions") with an optional note. -->
  <Style Selector="TextBlock.help">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.group">
    <Setter Property="Padding" Value="0,24,0,8" />
    <Setter Property="BorderBrush" Value="{StaticResource DividerSoftBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="TextBlock.groupTitle">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="0.22" />
    <Setter Property="Foreground" Value="{StaticResource Text4Brush}" />
  </Style>
  <Style Selector="TextBlock.groupNote">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
</Styles>
