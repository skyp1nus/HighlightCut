<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HighlightCut.App.ViewModels"
             xmlns:c="using:HighlightCut.App.Controls"
             xmlns:v="using:HighlightCut.App.Views"
             x:Class="HighlightCut.App.Views.ClipsPanel"
             x:DataType="vm:EditorViewModel">
  <!-- Data-table rows: grip, #, colour swatch, label and in – out, duration, include switch, remove. -->
  <Grid RowDefinitions="40,24,*,40">
    <!-- Tabs: Clips (with the count) and Transcript, and a hint on the right. -->
    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="10,0,12,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Classes="segs" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Classes="seg tab" Classes.on="{Binding IsClipsTab}" Command="{Binding ShowClipsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Clips" VerticalAlignment="Center" />
                <TextBlock Classes="mono" Text="{Binding ClipCountText}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="seg tab" Classes.on="{Binding IsTranscriptTab}" Command="{Binding ShowTranscriptCommand}" Content="Transcript" />
          </StackPanel>
        </Border>
        <TextBlock Grid.Column="2" Text="{Binding SidebarHint}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                   ToolTip.Tip="{Binding SidebarHintTip}" />
      </Grid>
    </Border>

    <Border Grid.Row="1" BorderBrush="{StaticResource DividerSoftBrush}" BorderThickness="0,0,0,1" Padding="12,0" IsVisible="{Binding IsClipsTab}">
      <Grid Classes="cols" ColumnDefinitions="10,8,16,8,10,8,*,8,76,8,26,8,20">
        <TextBlock Grid.Column="2" Classes="colhead" Text="#" />
        <TextBlock Grid.Column="6" Classes="colhead" Text="Label · In – Out" />
        <TextBlock Grid.Column="8" Classes="colhead" Text="Duration" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="10" Classes="colhead" Text="Out" HorizontalAlignment="Center" />
      </Grid>
    </Border>

    <Panel Grid.Row="2" IsVisible="{Binding IsClipsTab}">
      <StackPanel IsVisible="{Binding HasNoClips}" Margin="20,28" Spacing="6" VerticalAlignment="Top">
        <TextBlock Text="No clips yet" Foreground="{StaticResource Text2Brush}" />
        <TextBlock Text="Open a video, then press I and O to mark a segment, or ask Claude to find the parts you want."
                   FontSize="11.5" LineHeight="17.25" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <ScrollViewer Name="ListScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl Name="ClipList" ItemsSource="{Binding Clips}">
          <ItemsControl.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{Binding ExcludeLabel}" InputGesture="E" Command="{Binding ToggleExcludeCommand}"
                        IsEnabled="{Binding HasSelection}" />
              <MenuItem Header="Split at playhead" InputGesture="S" Command="{Binding SplitCommand}" />
              <MenuItem Classes="colors" Header="Colour" ItemsSource="{Binding SelectedClip.ColorChoices, FallbackValue={x:Null}}"
                        IsEnabled="{Binding HasSelection}">
                <MenuItem.Styles>
                  <Style Selector="MenuItem.colors > MenuItem" x:DataType="vm:ClipColorChoice">
                    <Setter Property="Header" Value="{Binding Name}" />
                    <Setter Property="Command" Value="{Binding Pick}" />
                    <Setter Property="Icon">
                      <Template>
                        <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Brush}" />
                      </Template>
                    </Setter>
                    <Setter Property="ToggleType" Value="Radio" />
                    <Setter Property="IsChecked" Value="{Binding IsCurrent}" />
                  </Style>
                </MenuItem.Styles>
              </MenuItem>
              <MenuItem Header="Join with next" InputGesture="J" Command="{Binding JoinWithNextCommand}"
                        IsEnabled="{Binding CanJoinWithNext}" />
              <Separator />
              <MenuItem Header="Delete clip" InputGesture="Delete" Command="{Binding DeleteClipCommand}"
                        IsEnabled="{Binding HasSelection}" />
            </ContextMenu>
          </ItemsControl.ContextMenu>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ClipViewModel">
              <Border Classes="row" Height="42" Padding="12,0" BorderBrush="{StaticResource DividerSoftBrush}" BorderThickness="0,0,0,1"
                      Classes.sel="{Binding IsSelected}" Classes.off="{Binding !IsIncluded}"
                      Classes.over="{Binding IsDropTarget}" Classes.dragging="{Binding IsDragSource}">
                <Panel>
                  <Border Classes="dropline" Height="1" VerticalAlignment="Top" Margin="-12,0" />
                  <Grid ColumnDefinitions="10,8,16,8,10,8,*,8,76,8,26,8,20">
                    <!-- Grip: 2 × 3 dots. -->
                    <Grid Classes="grip" ColumnDefinitions="2,2,2" RowDefinitions="2,2,2,2,2" VerticalAlignment="Center"
                          HorizontalAlignment="Left" Background="Transparent" Cursor="SizeAll">
                      <Border Grid.Column="0" Grid.Row="0" />
                      <Border Grid.Column="2" Grid.Row="0" />
                      <Border Grid.Column="0" Grid.Row="2" />
                      <Border Grid.Column="2" Grid.Row="2" />
                      <Border Grid.Column="0" Grid.Row="4" />
                      <Border Grid.Column="2" Grid.Row="4" />
                    </Grid>
                    <TextBlock Grid.Column="2" Classes="mono num" Text="{Binding Number}" FontSize="11" VerticalAlignment="Center" />
                    <!-- The clip's colour; a click opens the swatches. -->
                    <Button Grid.Column="4" Classes="swatch" Width="10" Height="10" CornerRadius="3" Background="{Binding ColorBrush}"
                            VerticalAlignment="Center" ToolTip.Tip="{Binding ColorName, StringFormat='Colour: {0}'}">
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <ItemsControl Classes="swatches" ItemsSource="{Binding ColorChoices}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <UniformGrid Columns="5" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ClipColorChoice">
                                <Button Classes="pick" Classes.current="{Binding IsCurrent}" Command="{Binding Pick}" Click="OnColorPicked"
                                        ToolTip.Tip="{Binding Name}">
                                  <Border Width="16" Height="16" CornerRadius="4" Background="{Binding Brush}" />
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                    <StackPanel Grid.Column="6" Classes="fade" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="mono" Text="{Binding RangeText}" FontSize="10.5" LetterSpacing="-0.2"
                                 Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="8" Classes="mono fade" Text="{Binding ShortDurationText}" FontSize="11"
                               Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="10" Theme="{StaticResource Switch}" HorizontalAlignment="Center" VerticalAlignment="Center"
                              ToolTip.Tip="Include in output" IsChecked="{Binding IncludeToggle}" />
                    <Button Grid.Column="12" Classes="ghost risky" Width="20" Height="20" CornerRadius="5"
                            ToolTip.Tip="Remove (Del)"
                            Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).RemoveClipCommand}"
                            CommandParameter="{Binding}">
                      <c:SvgIcon Data="{StaticResource IconRemove10}" ViewBox="10" StrokeWidth="1.2" LineCap="Flat" Width="10" Height="10" />
                    </Button>
                  </Grid>
                </Panel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>

    <!-- The wrapper keeps visibility bound to the editor, not to the panel's data context. -->
    <Panel Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding IsTranscriptTab}">
      <v:TranscriptPanel DataContext="{Binding TranscriptPanel}" />
    </Panel>

    <Border Grid.Row="3" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <TextBlock Text="Output" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding OutputSummary}" FontSize="11.5" Foreground="{StaticResource Text2Brush}"
                   VerticalAlignment="Center" Margin="8,0,0,0" />
        <TextBlock Grid.Column="3" Classes="mono" Text="{Binding OutputTimecode}" FontSize="13" Foreground="{StaticResource TextBrush}"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Button.tab">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.colhead">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LetterSpacing" Value="0.2" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.row.sel">
      <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    </Style>
    <Style Selector="Border.row.dragging">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Border.dropline">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.row.over Border.dropline">
      <Setter Property="Background" Value="{StaticResource Text2Brush}" />
    </Style>
    <Style Selector="Grid.grip">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Grid.grip > Border">
      <Setter Property="Background" Value="{StaticResource Text4Brush}" />
    </Style>
    <Style Selector="TextBlock.num">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="Border.row.sel TextBlock.num">
      <Setter Property="Foreground" Value="{StaticResource LinkBrush}" />
    </Style>
    <Style Selector="Border.row.off :is(Control).fade">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <!-- Swatches: a plain rounded square, lit up a little on hover; the current colour in the picker has a ring. -->
    <Style Selector="Button.swatch">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Border.row.off Button.swatch">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.swatch:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.2)" />
    </Style>
    <Style Selector="ItemsControl.swatches">
      <Setter Property="Margin" Value="-2" />
    </Style>
    <Style Selector="Button.pick">
      <Setter Property="Padding" Value="2" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.pick:pointerover">
      <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
    </Style>
    <Style Selector="Button.pick.current">
      <Setter Property="BorderBrush" Value="{StaticResource TextBrush}" />
    </Style>
  </UserControl.Styles>
</UserControl>
