<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HighlightCut.App.ViewModels"
             xmlns:c="using:HighlightCut.App.Controls"
             x:Class="HighlightCut.App.Views.Settings.McpSection"
             x:DataType="vm:SettingsViewModel">
  <!-- MCP server: status and the switch, what Claude may do without asking, and how to add HighlightCut to Claude. -->
  <StackPanel>
    <Border Name="StatusCard" Margin="0,14,0,0" Padding="16,14" CornerRadius="8.77" Background="{StaticResource PanelDeepBrush}"
            BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
      <Grid ColumnDefinitions="8,12,*,12,Auto">
        <Panel Name="Dot" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center">
          <c:PulseDot IsVisible="{Binding IsMcpDotEditing}" Fill="{StaticResource StatusOnBrush}" />
          <Ellipse IsVisible="{Binding IsMcpDotConnected}" Fill="{StaticResource StatusOnBrush}" Effect="drop-shadow(0 0 4 #8C22C55E)" />
          <Ellipse IsVisible="{Binding IsMcpDotOff}" Stroke="{StaticResource StatusOffBrush}" StrokeThickness="1" />
          <Ellipse IsVisible="{Binding IsMcpDotIdle}" Fill="{StaticResource StatusOffBrush}" />
        </Panel>
        <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
          <TextBlock Name="StatusTitle" Text="{Binding McpStatusTitle}" FontSize="13" FontWeight="Medium" LetterSpacing="-0.2"
                     Foreground="{StaticResource TextBrush}" />
          <TextBlock Name="StatusDetail" Text="{Binding McpStatusDetail}" FontSize="11.5" LineHeight="16.7" TextWrapping="Wrap"
                     Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <CheckBox Grid.Column="4" Theme="{StaticResource SettingSwitch}" Content="Let Claude connect" IsChecked="{Binding McpEnabled}"
                  VerticalAlignment="Top" />
      </Grid>
    </Border>

    <Border Classes="group">
      <StackPanel Spacing="3">
        <TextBlock Classes="groupTitle" Text="Permissions" />
        <TextBlock Classes="groupNote" Text="What Claude may do without asking" />
      </StackPanel>
    </Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label top" Text="Edit the timeline" />
      <StackPanel Grid.Column="2" Spacing="8" Margin="0,10">
        <TextBlock Text="Always" FontSize="12" Foreground="{StaticResource TextBrush}" />
        <TextBlock Classes="help" Text="Every edit appears as a card in the Claude panel with its own Undo." />
      </StackPanel>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label" Text="Open files" />
      <Border Grid.Column="2" Classes="segs" VerticalAlignment="Center">
        <ItemsControl ItemsSource="{Binding OpenFilesOptions}" ItemsPanel="{StaticResource SegPanel}" ItemTemplate="{StaticResource SegItem}" />
      </Border>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label" Text="Save the project" />
      <Border Grid.Column="2" Classes="segs" VerticalAlignment="Center">
        <ItemsControl ItemsSource="{Binding SaveProjectOptions}" ItemsPanel="{StaticResource SegPanel}" ItemTemplate="{StaticResource SegItem}" />
      </Border>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label top" Text="Export" />
      <StackPanel Grid.Column="2" Spacing="8" Margin="0,10">
        <Border Classes="segs">
          <ItemsControl ItemsSource="{Binding ExportOptions}" ItemsPanel="{StaticResource SegPanel}" ItemTemplate="{StaticResource SegItem}" />
        </Border>
        <TextBlock Classes="help" Text="{Binding ExportPermissionNote}" />
      </StackPanel>
    </Grid></Border>

    <Border Classes="group">
      <StackPanel Spacing="3">
        <TextBlock Classes="groupTitle" Text="Connect Claude" />
      </StackPanel>
    </Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label top" Text="Claude Code" />
      <StackPanel Grid.Column="2" Spacing="8" Margin="0,10">
        <Border Classes="code">
          <SelectableTextBlock Text="{Binding ClaudeCodeCommand}" />
        </Border>
        <Grid ColumnDefinitions="*,12,Auto">
          <TextBlock Classes="help" Text="Run once in a terminal. Adds HighlightCut for all your projects." VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="soft" Height="24" Padding="10,0" CornerRadius="6" FontSize="11.5"
                  Content="{Binding ClaudeCodeCopyLabel}" Command="{Binding CopyClaudeCodeCommand}" />
        </Grid>
        <TextBlock Name="ClaudeCodeRenameNote" Classes="help" IsVisible="{Binding ShowRenameNote}"
                   Text="HighlightCut was called OurCut before. If you added it to Claude Code then, remove it with “claude mcp remove --scope user ourcut” and run the command above again." />
      </StackPanel>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label top" Text="Claude Desktop" />
      <StackPanel Grid.Column="2" Spacing="8" Margin="0,10">
        <Border Classes="code">
          <SelectableTextBlock Text="{Binding ClaudeDesktopConfig}" />
        </Border>
        <WrapPanel ItemSpacing="8" LineSpacing="4">
          <TextBlock Text="Add to" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
          <TextBlock Classes="mono" Text="{Binding McpConfigPathText}" FontSize="11" Foreground="{StaticResource Text2Brush}"
                     VerticalAlignment="Center" />
          <Button Classes="link" FontSize="12" Content="Open file" Command="{Binding OpenClaudeDesktopConfigCommand}"
                  VerticalAlignment="Center" />
        </WrapPanel>
        <Grid ColumnDefinitions="*,12,Auto">
          <TextBlock Classes="help" Text="Restart Claude Desktop after saving the file." VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="soft" Height="24" Padding="10,0" CornerRadius="6" FontSize="11.5"
                  Content="{Binding ClaudeDesktopCopyLabel}" Command="{Binding CopyClaudeDesktopCommand}" />
        </Grid>
        <TextBlock Name="ClaudeDesktopRenameNote" Classes="help" IsVisible="{Binding ShowRenameNote}"
                   Text="If the file has an “ourcut” entry from before the rename, replace it with this one: it starts the old program." />
      </StackPanel>
    </Grid></Border>
  </StackPanel>

  <UserControl.Styles>
    <Style Selector="Border.code">
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{StaticResource WindowBrush}" />
      <Setter Property="BorderBrush" Value="#14FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.code SelectableTextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="LineHeight" Value="16.8" />
      <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>
</UserControl>
