<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HighlightCut.App.ViewModels"
             xmlns:c="using:HighlightCut.App.Controls"
             x:Class="HighlightCut.App.Views.Settings.TranscriptionSection"
             x:DataType="vm:SettingsViewModel">
  <!-- Engine, model, device, language, when to transcribe, filler words, models folder and the models table. -->
  <StackPanel>
    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label" Text="Engine" />
      <Border Grid.Column="2" Classes="segs" VerticalAlignment="Center">
        <ItemsControl ItemsSource="{Binding EngineOptions}" ItemsPanel="{StaticResource SegPanel}" ItemTemplate="{StaticResource SegItem}" />
      </Border>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label" Text="Model" />
      <ComboBox Grid.Column="2" Classes="field" Width="320" HorizontalAlignment="Left" VerticalAlignment="Center"
                ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding Model}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ModelOption">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label" Text="Device" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Border Classes="segs">
          <ItemsControl ItemsSource="{Binding DeviceOptions}" ItemsPanel="{StaticResource SegPanel}" ItemTemplate="{StaticResource SegItem}" />
        </Border>
        <TextBlock Text="{Binding DeviceNote}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label" Text="Language" />
      <ComboBox Grid.Column="2" Classes="field" Width="200" HorizontalAlignment="Left" VerticalAlignment="Center"
                ItemsSource="{x:Static vm:SettingsViewModel.Languages}" SelectedItem="{Binding Language}" />
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label top" Text="Automatic" />
      <StackPanel Grid.Column="2" Spacing="8" Margin="0,10">
        <CheckBox Theme="{StaticResource SettingSwitch}" Content="Transcribe when a video is opened" IsChecked="{Binding TranscribeOnOpen}" />
        <TextBlock Classes="help" Text="When off, transcription starts when you or Claude ask for it." />
      </StackPanel>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label top" Text="Filler words" />
      <StackPanel Grid.Column="2" Spacing="8" Margin="0,10">
        <ItemsControl ItemsSource="{Binding FillerLanguages}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FillerLanguageViewModel">
              <Grid ColumnDefinitions="72,10,*">
                <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"
                           VerticalAlignment="Top" />
                <!-- Chips and the "Add…" box share one wrap panel; 2 px of slack for chip widths rounded up to whole pixels. -->
                <ItemsControl Grid.Column="2" Margin="0,0,-2,0" ItemsSource="{Binding Entries}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemSpacing="6" LineSpacing="6" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:FillerWordViewModel" x:DataType="vm:FillerWordViewModel">
                      <Border Classes="filler">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                          <TextBlock Text="{Binding Word}" FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                          <Button Classes="ghost bright" Width="18" Height="18" Padding="0" CornerRadius="4" Foreground="{StaticResource MutedBrush}"
                                  VerticalAlignment="Center" ToolTip.Tip="Remove" Command="{Binding RemoveCommand}">
                            <c:SvgIcon Data="{StaticResource IconClose10}" ViewBox="10" StrokeWidth="1.4" LineCap="Flat" Width="8" Height="8" />
                          </Button>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                    <DataTemplate DataType="vm:FillerLanguageViewModel" x:DataType="vm:FillerLanguageViewModel">
                      <Panel Classes="draft" Width="72" Height="24">
                        <Rectangle Name="Dash" RadiusX="6" RadiusY="6" Stroke="#33FFFFFF" StrokeThickness="1" StrokeDashArray="3,2" />
                        <TextBox Classes="bare filler" Text="{Binding Draft}" PlaceholderText="Add…" Padding="8,0" FontSize="12"
                                 CornerRadius="6" VerticalContentAlignment="Center" />
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.DataTemplates>
                </ItemsControl>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="help" Text="Marked in the transcript. Claude uses them to find filler words to cut. Press Enter to add a word." />
      </StackPanel>
    </Grid></Border>

    <Border Classes="row last" MinHeight="52"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label" Text="Models folder" />
      <Grid Grid.Column="2" ColumnDefinitions="*,8,Auto,8,Auto" VerticalAlignment="Center">
        <Border Classes="field" ToolTip.Tip="{Binding ModelsFolder}">
          <TextBlock Text="{Binding ModelsFolder}" />
        </Border>
        <Button Grid.Column="2" Classes="soft" Height="30" Padding="12,0" Content="Change" Command="{Binding ChangeFolderCommand}" />
        <Button Grid.Column="4" Classes="link" Content="Open" Command="{Binding OpenFolderCommand}" VerticalAlignment="Center" />
      </Grid>
    </Grid></Border>

    <!-- Models table. -->
    <Border Margin="0,4,0,0" CornerRadius="8.77" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" ClipToBounds="True">
      <StackPanel>
        <Border Height="26" Padding="12,0" Background="{StaticResource PanelDeepBrush}" BorderBrush="{StaticResource DividerSoftBrush}"
                BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,12,60,12,56,12,200">
            <TextBlock Classes="colhead" Text="Model" />
            <TextBlock Grid.Column="2" Classes="colhead" Text="Engine" />
            <TextBlock Grid.Column="4" Classes="colhead" Text="Size" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="6" Classes="colhead" Text="{Binding DiskFreeText}" HorizontalAlignment="Right" />
          </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding Models}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TranscriptionModelViewModel">
              <Border MinHeight="40" Padding="12,7" BorderBrush="{StaticResource DividerSoftBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,12,60,12,56,12,200">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <!-- The id gives way (ellipsis) before the badge does. -->
                    <DockPanel HorizontalAlignment="Left">
                      <Border DockPanel.Dock="Right" IsVisible="{Binding IsInstalled}" Height="16" Margin="8,0,0,0" Padding="5,0"
                              CornerRadius="4" BorderThickness="1" BorderBrush="#804ADE80" VerticalAlignment="Center">
                        <TextBlock Text="Installed" FontSize="9.5" FontWeight="Medium" Foreground="{StaticResource StatusOnBrush}"
                                   VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Classes="mono" Text="{Binding Id}" FontSize="11.5" Foreground="{StaticResource TextBrush}"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Languages}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Note}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Engine}" FontSize="11.5" Foreground="{StaticResource Text4Brush}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Classes="mono" Text="{Binding Size}" FontSize="11" Foreground="{StaticResource Text2Brush}"
                             HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsDownloading}">
                      <ProgressBar Width="64" MinWidth="0" Height="3" MinHeight="3" CornerRadius="2" Minimum="0" Maximum="1" Value="{Binding Progress}"
                                   Background="{StaticResource FieldBrush}" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                      <TextBlock Classes="mono" Text="{Binding PercentText}" FontSize="10.5" Width="28" TextAlignment="Right"
                                 Foreground="{StaticResource Text4Brush}" VerticalAlignment="Center" />
                      <Button Classes="ghost bright" Width="20" Height="20" CornerRadius="5" Foreground="{StaticResource MutedBrush}"
                              ToolTip.Tip="Cancel download" Command="{Binding CancelDownloadCommand}">
                        <c:SvgIcon Data="{StaticResource IconClose10}" ViewBox="10" StrokeWidth="1.2" LineCap="Flat" Width="9" Height="9" />
                      </Button>
                    </StackPanel>
                    <Button Classes="danger" IsVisible="{Binding IsInstalled}" IsEnabled="{Binding CanManage}" Height="24" Padding="10,0"
                            CornerRadius="6" FontSize="11.5" FontWeight="Normal" Content="Delete" Command="{Binding DeleteCommand}"
                            ToolTip.Tip="Delete the model files" />
                    <Button Classes="soft" IsVisible="{Binding IsNotInstalled}" IsEnabled="{Binding CanManage}" Height="24" Padding="10,0"
                            CornerRadius="6" FontSize="11.5" Content="Download" Command="{Binding DownloadCommand}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsFailed}">
                      <TextBlock Text="Download failed" FontSize="11" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                      <Button Classes="soft" IsEnabled="{Binding CanManage}" Height="24" Padding="10,0" CornerRadius="6" FontSize="11.5"
                              Content="Retry" Command="{Binding RetryCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsNoSpace}">
                      <TextBlock Text="Not enough space" FontSize="11" Foreground="{StaticResource Text4Brush}" VerticalAlignment="Center" />
                      <Button Classes="soft" IsEnabled="False" Height="24" Padding="10,0" CornerRadius="6" FontSize="11.5" Content="Download" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <TextBlock Classes="help" Margin="2,10,2,0" IsVisible="{Binding HasNoSpaceModels}" Text="{Binding NoSpaceText}" />
  </StackPanel>

  <UserControl.Styles>
    <!-- Settings fade disabled buttons to 0.4 (the title-bar pill keeps the global 0.35). -->
    <Style Selector="Button.soft:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <!-- Filler word chip: 5 % fill, hairline, room for the ✕ on the right. -->
    <Style Selector="Border.filler">
      <Setter Property="Height" Value="24" />
      <!-- The design's hairline is an inset shadow; 1 px of padding each side keeps its width. -->
      <Setter Property="Padding" Value="8,0,2,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{StaticResource ControlBrush}" />
      <Setter Property="BorderBrush" Value="#14FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- "Add…": dashed until focused, then a solid blue ring. -->
    <Style Selector="Panel.draft:focus-within > Rectangle#Dash">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TextBox.filler">
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="TextBox.filler:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource FocusRingBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </UserControl.Styles>
</UserControl>
