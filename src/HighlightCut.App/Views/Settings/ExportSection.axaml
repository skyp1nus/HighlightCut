<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HighlightCut.App.ViewModels"
             xmlns:sys="using:System"
             x:Class="HighlightCut.App.Views.Settings.ExportSection"
             x:DataType="vm:SettingsViewModel">
  <!-- The Export dialog's defaults. -->
  <StackPanel>
    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label top" Text="Mode" />
      <StackPanel Grid.Column="2" Spacing="8" Margin="0,10">
        <Border Classes="segs">
          <ItemsControl ItemsSource="{Binding ExportModeOptions}" ItemsPanel="{StaticResource SegPanel}" ItemTemplate="{StaticResource SegItem}" />
        </Border>
        <TextBlock Classes="help" Text="{Binding ModeNote}" />
      </StackPanel>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label" Text="Container" />
      <Border Grid.Column="2" Classes="segs" VerticalAlignment="Center">
        <ItemsControl ItemsSource="{Binding ContainerOptions}" ItemsPanel="{StaticResource SegPanel}" ItemTemplate="{StaticResource SegItem}" />
      </Border>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label top" Text="Output folder" />
      <StackPanel Grid.Column="2" Spacing="8" Margin="0,10">
        <Border Classes="segs">
          <ItemsControl ItemsSource="{Binding ExportFolderOptions}" ItemsPanel="{StaticResource SegPanel}" ItemTemplate="{StaticResource SegItem}" />
        </Border>
        <Grid Name="FixedFolderRow" ColumnDefinitions="*,8,Auto" IsVisible="{Binding IsFixedFolder}">
          <Border Classes="field" ToolTip.Tip="{Binding FixedExportFolder}">
            <TextBlock Text="{Binding FixedExportFolder}" />
          </Border>
          <Button Grid.Column="2" Classes="soft" Height="30" Padding="12,0" Content="Change" Command="{Binding ChangeExportFolderCommand}" />
        </Grid>
      </StackPanel>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label top" Text="File name" />
      <StackPanel Grid.Column="2" Spacing="8" Margin="0,10">
        <TextBox Name="PatternBox" Classes="field" Text="{Binding FileNamePattern}" ClearSelectionOnLostFocus="False" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Insert" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,2,0" VerticalAlignment="Center" />
          <ItemsControl ItemsSource="{x:Static vm:SettingsViewModel.PatternTokens}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sys:String">
                <Button Classes="token" Content="{Binding}" Click="OnTokenClick" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <Border Classes="preview">
          <Grid ColumnDefinitions="60,12,*" RowDefinitions="Auto,6,Auto">
            <TextBlock Text="Merged" FontSize="11" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Grid.Column="2" Classes="mono name" Text="{Binding MergedNamePreview}" Foreground="{StaticResource TextBrush}" />
            <TextBlock Grid.Row="2" Text="Separate" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top" />
            <ItemsControl Grid.Row="2" Grid.Column="2" ItemsSource="{Binding SeparateNamePreview}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                  <TextBlock Classes="mono name" Text="{Binding}" Foreground="{StaticResource Text2Brush}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
        <TextBlock Classes="help" Text="{}{n} and {label} are left out of merged file names." />
      </StackPanel>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label top" Text="Merging" />
      <StackPanel Grid.Column="2" Spacing="8" Margin="0,10">
        <CheckBox Theme="{StaticResource SettingSwitch}" Content="Merge into one file" IsChecked="{Binding MergeFiles}" />
        <CheckBox Theme="{StaticResource SettingSwitch}" Content="Chapters from clip labels" IsChecked="{Binding ChaptersFromLabels}" />
        <TextBlock Classes="help" Text="Chapters are written to merged MP4, MOV and MKV files." />
      </StackPanel>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label" Text="Audio tracks" />
      <Border Grid.Column="2" Classes="segs" VerticalAlignment="Center">
        <ItemsControl ItemsSource="{Binding AudioTrackOptions}" ItemsPanel="{StaticResource SegPanel}" ItemTemplate="{StaticResource SegItem}" />
      </Border>
    </Grid></Border>

    <Border Classes="group">
      <StackPanel Spacing="3">
        <TextBlock Classes="groupTitle" Text="Re-encode" />
        <TextBlock Classes="groupNote" Text="Used when the mode is Re-encode." />
      </StackPanel>
    </Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label" Text="Video" />
      <Border Grid.Column="2" Classes="segs" VerticalAlignment="Center">
        <ItemsControl ItemsSource="{Binding ReencodeVideoOptions}" ItemsPanel="{StaticResource SegPanel}" ItemTemplate="{StaticResource SegItem}" />
      </Border>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label" Text="Audio" />
      <Border Grid.Column="2" Classes="segs" VerticalAlignment="Center">
        <ItemsControl ItemsSource="{Binding ReencodeAudioOptions}" ItemsPanel="{StaticResource SegPanel}" ItemTemplate="{StaticResource SegItem}" />
      </Border>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label top" Text="GPU encoder" />
      <StackPanel Grid.Column="2" Spacing="8" Margin="0,10">
        <CheckBox Theme="{StaticResource SettingSwitch}" Content="Use the GPU encoder when available" IsChecked="{Binding UseGpuEncoder}" />
        <TextBlock Classes="help" Text="{Binding GpuEncoderNote}" />
      </StackPanel>
    </Grid></Border>

    <Border Classes="group">
      <StackPanel Spacing="3">
        <TextBlock Classes="groupTitle" Text="Files" />
      </StackPanel>
    </Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label" Text="If the file exists" />
      <Border Grid.Column="2" Classes="segs" VerticalAlignment="Center">
        <ItemsControl ItemsSource="{Binding IfFileExistsOptions}" ItemsPanel="{StaticResource SegPanel}" ItemTemplate="{StaticResource SegItem}" />
      </Border>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label" Text="After export" />
      <Border Grid.Column="2" Classes="segs" VerticalAlignment="Center">
        <ItemsControl ItemsSource="{Binding AfterExportOptions}" ItemsPanel="{StaticResource SegPanel}" ItemTemplate="{StaticResource SegItem}" />
      </Border>
    </Grid></Border>
  </StackPanel>

  <UserControl.Styles>
    <!-- File name preview: 8 px box on the deep panel colour with a hairline. -->
    <Style Selector="Border.preview">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{StaticResource PanelDeepBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.preview TextBlock.name">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Styles>
</UserControl>
