<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HighlightCut.App.ViewModels"
             x:Class="HighlightCut.App.Views.Settings.PlaybackSection"
             x:DataType="vm:SettingsViewModel">
  <!-- Decoding, renderer, audio output, jump length. -->
  <StackPanel>
    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label top" Text="Hardware decoding" />
      <StackPanel Grid.Column="2" Spacing="8" Margin="0,10">
        <Border Classes="segs">
          <ItemsControl ItemsSource="{Binding HardwareDecodingOptions}" ItemsPanel="{StaticResource SegPanel}" ItemTemplate="{StaticResource SegItem}" />
        </Border>
        <TextBlock Classes="help" Text="Turn off if the video shows glitches." />
      </StackPanel>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label top" Text="Video renderer" />
      <StackPanel Grid.Column="2" Spacing="8" Margin="0,10">
        <Border Classes="segs">
          <ItemsControl ItemsSource="{Binding RendererOptions}" ItemsPanel="{StaticResource SegPanel}" ItemTemplate="{StaticResource SegItem}" />
        </Border>
        <TextBlock Classes="help" Text="Software rendering uses the CPU. Try it if the preview stays black or flickers." />
      </StackPanel>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label" Text="Audio output" />
      <ComboBox Grid.Column="2" Classes="field" Width="320" HorizontalAlignment="Left" VerticalAlignment="Center"
                ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding AudioDevice}" />
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label" Text="Jump length" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Border Classes="segs">
          <ItemsControl ItemsSource="{Binding JumpOptions}" ItemsPanel="{StaticResource SegPanel}" ItemTemplate="{StaticResource SegItem}" />
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="with" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
          <Border Classes="kbd key"><TextBlock Text="{Binding Keys.JumpBack}" /></Border>
          <Border Classes="kbd key"><TextBlock Text="{Binding Keys.JumpForward}" /></Border>
        </StackPanel>
      </StackPanel>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label" Text="Volume and speed" />
      <CheckBox Grid.Column="2" Theme="{StaticResource SettingSwitch}" Content="Remember between sessions" IsChecked="{Binding RememberVolumeAndSpeed}"
                VerticalAlignment="Center" />
    </Grid></Border>
  </StackPanel>
</UserControl>
