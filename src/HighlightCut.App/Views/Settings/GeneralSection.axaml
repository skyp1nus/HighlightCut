<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HighlightCut.App.ViewModels"
             x:Class="HighlightCut.App.Views.Settings.GeneralSection"
             x:DataType="vm:SettingsViewModel">
  <!-- Startup, autosave, recent files, cache, versions. -->
  <StackPanel>
    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label" Text="Startup" />
      <Border Grid.Column="2" Classes="segs" VerticalAlignment="Center">
        <ItemsControl ItemsSource="{Binding StartupOptions}" ItemsPanel="{StaticResource SegPanel}" ItemTemplate="{StaticResource SegItem}" />
      </Border>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label top" Text="Autosave" />
      <StackPanel Grid.Column="2" Spacing="8" Margin="0,10">
        <CheckBox Theme="{StaticResource SettingSwitch}" Content="Save projects automatically after each change" IsChecked="{Binding Autosave}" />
        <TextBlock Classes="help" Text="Only projects that have been saved once. A new project waits until you name it." />
      </StackPanel>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label" Text="Recent files" />
      <Grid Grid.Column="2" ColumnDefinitions="Auto,12,Auto,*,Auto" VerticalAlignment="Center">
        <Border Classes="segs">
          <ItemsControl ItemsSource="{Binding RecentLimitOptions}" ItemsPanel="{StaticResource SegPanel}" ItemTemplate="{StaticResource SegItem}" />
        </Border>
        <TextBlock Grid.Column="2" Text="files to remember" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
        <Button Grid.Column="4" Classes="link" Content="{Binding RecentLinkText}" Command="{Binding ClearRecentFilesCommand}"
                VerticalAlignment="Center" />
      </Grid>
    </Grid></Border>

    <Border Classes="group">
      <StackPanel Spacing="3">
        <TextBlock Classes="groupTitle" Text="Cache" />
        <TextBlock Classes="groupNote" Text="Thumbnails, waveforms, keyframes and scene data. Rebuilt when needed." />
      </StackPanel>
    </Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label" Text="Folder" />
      <Grid Grid.Column="2" ColumnDefinitions="*,12,Auto" VerticalAlignment="Center">
        <Border Classes="field" ToolTip.Tip="{Binding CacheFolder}">
          <TextBlock Text="{Binding CacheFolder}" />
        </Border>
        <Button Grid.Column="2" Classes="link" Content="Open" Command="{Binding OpenCacheFolderCommand}" VerticalAlignment="Center" />
      </Grid>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label" Text="Space used" />
      <Grid Grid.Column="2" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <TextBlock Classes="mono" Text="{Binding CacheUsedText}" FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="soft" Height="28" Padding="12,0" Content="Clear cache" Command="{Binding ClearCacheCommand}"
                IsEnabled="{Binding CanClearCache}" />
      </Grid>
    </Grid></Border>

    <Border Classes="group">
      <StackPanel Spacing="3">
        <TextBlock Classes="groupTitle" Text="About" />
      </StackPanel>
    </Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label top" Text="Versions" />
      <Grid Grid.Column="2" ColumnDefinitions="64,12,Auto" RowDefinitions="Auto,6,Auto,6,Auto" Margin="0,14" HorizontalAlignment="Left">
        <TextBlock Text="HighlightCut" FontSize="12" Foreground="{StaticResource MutedBrush}" />
        <TextBlock Grid.Column="2" Classes="mono version" Text="{Binding AppVersion}" />
        <TextBlock Grid.Row="2" Text="ffmpeg" FontSize="12" Foreground="{StaticResource MutedBrush}" />
        <TextBlock Grid.Row="2" Grid.Column="2" Classes="mono version" Text="{Binding FfmpegVersion}" />
        <TextBlock Grid.Row="4" Text="libmpv" FontSize="12" Foreground="{StaticResource MutedBrush}" />
        <TextBlock Grid.Row="4" Grid.Column="2" Classes="mono version" Text="{Binding LibmpvVersion}" />
      </Grid>
    </Grid></Border>

    <Border Classes="row"><Grid ColumnDefinitions="120,16,*">
      <TextBlock Classes="label" Text="Support" />
      <Grid Grid.Column="2" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <Button Classes="link" Content="Open logs folder" Command="{Binding OpenLogsFolderCommand}" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="soft" Height="28" Padding="12,0" Content="{Binding DiagnosticsButtonText}"
                Command="{Binding CopyDiagnosticsCommand}" />
      </Grid>
    </Grid></Border>
  </StackPanel>

  <UserControl.Styles>
    <!-- Settings fade disabled buttons to 0.4 (the title-bar pill keeps the global 0.35). -->
    <Style Selector="Button.soft:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <!-- Version numbers line up with the 12 px names: mono 11.5, centred in the taller line. -->
    <Style Selector="TextBlock.version">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
</UserControl>
