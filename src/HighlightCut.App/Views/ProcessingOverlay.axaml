<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HighlightCut.App.ViewModels"
             xmlns:v="using:HighlightCut.App.Views"
             xmlns:c="using:HighlightCut.App.Controls"
             x:Class="HighlightCut.App.Views.ProcessingOverlay"
             x:DataType="vm:ProcessingViewModel"
             IsVisible="{Binding IsVisible}"
             Classes.shown="{Binding IsShown}"
             Classes.leaving="{Binding IsLeaving}"
             Background="{StaticResource WindowBrush}"
             AutomationProperties.Name="{Binding FileName, StringFormat='Preparing {0}'}">
  <!-- Design "HighlightCut — екран обробки", X1: fades and settles in, and fades out growing a little, into the editor. -->
  <UserControl.Styles>
    <Style Selector="v|ProcessingOverlay">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.45" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="v|ProcessingOverlay.shown">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="v|ProcessingOverlay StackPanel#Body">
      <Setter Property="RenderTransform" Value="scale(0.94)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.6" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="v|ProcessingOverlay.shown StackPanel#Body">
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="v|ProcessingOverlay.leaving StackPanel#Body">
      <Setter Property="RenderTransform" Value="scale(1.04)" />
    </Style>
  </UserControl.Styles>

  <StackPanel Name="Body" Spacing="36" HorizontalAlignment="Center" VerticalAlignment="Center">
    <c:BlobView Width="150" Height="150" HorizontalAlignment="Center" IsPlaying="{Binding IsVisible}" />
    <StackPanel Spacing="14" HorizontalAlignment="Center">
      <StackPanel Spacing="6" HorizontalAlignment="Center">
        <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="Medium" Foreground="#F2F2F2" HorizontalAlignment="Center"
                   MaxWidth="480" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Details}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                   HorizontalAlignment="Center" />
      </StackPanel>
      <Border Width="220" Height="2" CornerRadius="1" Background="#0FFFFFFF" HorizontalAlignment="Center" ClipToBounds="True">
        <Border Width="{Binding ProgressWidth}" Height="2" CornerRadius="1" Background="#8CFFFFFF" HorizontalAlignment="Left">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Width" Duration="0:0:0.3" Easing="CubicEaseOut" />
            </Transitions>
          </Border.Transitions>
        </Border>
      </Border>
      <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
    </StackPanel>
  </StackPanel>
</UserControl>
