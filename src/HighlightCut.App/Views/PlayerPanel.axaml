<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HighlightCut.App.ViewModels"
             xmlns:c="using:HighlightCut.App.Controls"
             xmlns:v="using:HighlightCut.App.Views"
             x:Class="HighlightCut.App.Views.PlayerPanel"
             x:DataType="vm:EditorViewModel">
  <Grid RowDefinitions="*,48" Background="{StaticResource VideoAreaBrush}">

    <Panel Margin="20,16,20,8">
      <!-- Empty state: a 16:9 drop zone. -->
      <c:AspectPanel IsVisible="{Binding IsEmpty}">
        <Panel Name="DropZone" Background="Transparent" DragDrop.AllowDrop="True">
          <Rectangle Name="DropBorder" RadiusX="12" RadiusY="12" StrokeThickness="1" Stroke="#24FFFFFF"
                     StrokeDashArray="4,3" Fill="#04FFFFFF" />
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
            <Border Width="44" Height="44" CornerRadius="10" Background="#08FFFFFF" BorderBrush="{StaticResource OutlineBrush}"
                    BorderThickness="1" HorizontalAlignment="Center">
              <c:SvgIcon Data="{StaticResource IconDrop16}" ViewBox="16" StrokeWidth="1.2" Width="18" Height="18"
                         Foreground="{StaticResource MutedBrush}" />
            </Border>
            <StackPanel Spacing="6" HorizontalAlignment="Center">
              <TextBlock Text="Drop a video here" FontSize="18" LetterSpacing="-0.6" Foreground="{StaticResource TextBrush}"
                         HorizontalAlignment="Center" />
              <TextBlock Text="MP4, MOV, MKV, WebM, TS and most ffmpeg-readable files" Foreground="{StaticResource MutedBrush}"
                         HorizontalAlignment="Center" />
            </StackPanel>
            <Button Classes="soft" Height="28" Padding="12,0,8,0" HorizontalAlignment="Center" Command="{Binding OpenFileCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Browse files" VerticalAlignment="Center" />
                <Border Classes="kbd"><TextBlock Text="{Binding Settings.Keys.OpenVideo}" /></Border>
              </StackPanel>
            </Button>
            <TextBlock Text="Or ask Claude: “open the latest recording in Videos”" FontSize="11" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" />
            <!-- Recently opened files (not in the design, kept from Phase 1). -->
            <StackPanel Width="400" Spacing="2" IsVisible="{Binding HasRecentFiles}">
              <TextBlock Text="Recent" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="10,0,10,4" />
              <!-- Up to 20 files (Settings → General); eight rows show, the rest scroll. -->
              <ScrollViewer MaxHeight="224" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding RecentFiles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecentFileViewModel">
                      <Button Classes="recent" Height="28" Padding="10,0" CornerRadius="6" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" FontWeight="Normal"
                              Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).OpenRecentCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{Binding Path}">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <TextBlock Classes="mono" Text="{Binding Name}" FontSize="11.5" Foreground="{StaticResource Text2Brush}"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Classes="mono" Text="{Binding DurationText}" FontSize="11"
                                     Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                          <TextBlock Grid.Column="2" Text="{Binding WhenText}" FontSize="11" Width="70" TextAlignment="Right"
                                     Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </StackPanel>
        </Panel>
      </c:AspectPanel>

      <!-- Player picture with overlays. VideoSurface is where playback draws. -->
      <c:AspectPanel IsVisible="{Binding HasFile}" Ratio="{Binding VideoAspect}">
        <Border CornerRadius="6" ClipToBounds="True" BoxShadow="0 0 0 1 #14FFFFFF">
          <Panel>
            <c:VideoSurface Media="{Binding Media}" Time="{Binding Time}" Caption="{Binding FrameText}" />
            <!-- libmpv video on top; until its first frame the thumbnail underneath shows through. -->
            <c:VideoView Name="Video" Player="{Binding Player}" SoftwareOnly="{Binding Settings.UsesSoftwareRenderer}"
                         Output="{Binding VideoOutput, Mode=OneWayToSource}" IsVisible="{Binding HasPlayback}" />
            <Border IsVisible="{Binding IsInClip}" Classes="overlay" HorizontalAlignment="Left" VerticalAlignment="Top">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="mono" Text="{Binding CurrentClipNumber}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CurrentClipLabel}" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border IsVisible="{Binding IsInExcluded}" Classes="overlay" HorizontalAlignment="Left" VerticalAlignment="Top">
              <TextBlock Text="Not in output" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            </Border>
          </Panel>
        </Border>
      </c:AspectPanel>
    </Panel>

    <!-- Transport: frame step, play, timecode | set in / out | volume, speed. -->
    <Grid Grid.Row="1" Name="Transport" Margin="20,0" ColumnDefinitions="340,*,340" Classes.disabled="{Binding IsEmpty}">
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Classes="ghost" Width="28" Height="28" Foreground="{StaticResource Text2Brush}" ToolTip.Tip="Previous frame (←)"
                Command="{Binding StepBackCommand}">
          <c:SvgIcon Data="{StaticResource IconStepBack14}" ViewBox="14" IsFilled="True" Width="14" Height="14" />
        </Button>
        <Button Classes="white" Width="32" Height="32" CornerRadius="16" ToolTip.Tip="Play / pause (Space)"
                Command="{Binding TogglePlayCommand}">
          <Panel Width="14" Height="14">
            <c:SvgIcon Data="{StaticResource IconPlay14}" ViewBox="14" IsFilled="True" IsVisible="{Binding !IsPlaying}" />
            <c:SvgIcon Data="{StaticResource IconPause14}" ViewBox="14" IsFilled="True" IsVisible="{Binding IsPlaying}" />
          </Panel>
        </Button>
        <Button Classes="ghost" Width="28" Height="28" Foreground="{StaticResource Text2Brush}" ToolTip.Tip="Next frame (→)"
                Command="{Binding StepForwardCommand}">
          <c:SvgIcon Data="{StaticResource IconStepForward14}" ViewBox="14" IsFilled="True" Width="14" Height="14" />
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Classes="mono" Text="{Binding TimeText}" Foreground="{StaticResource TextBrush}" />
          <TextBlock Classes="mono" Text="/" Foreground="{StaticResource Muted3Brush}" />
          <TextBlock Classes="mono" Text="{Binding TransportDurationText}" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button Classes="soft" Height="26" Padding="10,0,6,0" FontSize="11.5" Foreground="{StaticResource Text2Brush}"
                ToolTip.Tip="Set in-point (I)" Command="{Binding MarkInCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Set in" VerticalAlignment="Center" />
            <Border Classes="kbd"><TextBlock Text="{Binding Settings.Keys.SetIn}" /></Border>
          </StackPanel>
        </Button>
        <Button Classes="soft" Height="26" Padding="10,0,6,0" FontSize="11.5" Foreground="{StaticResource Text2Brush}"
                ToolTip.Tip="Set out-point (O)" Command="{Binding MarkOutCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Set out" VerticalAlignment="Center" />
            <Border Classes="kbd"><TextBlock Text="{Binding Settings.Keys.SetOut}" /></Border>
          </StackPanel>
        </Button>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Panel Width="16" Height="16" VerticalAlignment="Center">
          <c:SvgIcon Data="{StaticResource IconSpeaker16}" ViewBox="16" IsFilled="True" Foreground="{StaticResource Text4Brush}" />
          <c:SvgIcon Data="{StaticResource IconSpeakerWaves16}" ViewBox="16" StrokeWidth="1.1" Foreground="{StaticResource Text4Brush}" />
        </Panel>
        <Slider Theme="{StaticResource VolumeSlider}" Width="84" Minimum="0" Maximum="1" Value="{Binding Volume}"
                VerticalAlignment="Center" ToolTip.Tip="Volume" />
        <Button Classes="soft" Height="24" MinWidth="48" Padding="8,0" CornerRadius="6" ToolTip.Tip="Playback speed"
                Foreground="{StaticResource Text2Brush}" Command="{Binding CycleSpeedCommand}">
          <TextBlock Classes="mono" Text="{Binding SpeedText}" FontSize="11" FontWeight="Medium" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Claude's request to export, open or save, over the preview. -->
    <v:ClaudeRequestBanner Grid.RowSpan="2" VerticalAlignment="Top" Margin="20,12,20,0" MaxWidth="680"
                           DataContext="{Binding Claude.Request}" />
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.overlay">
      <Setter Property="Margin" Value="12" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="#CC0B0C0E" />
      <Setter Property="BoxShadow" Value="0 0 0 1 #1AFFFFFF" />
    </Style>
    <Style Selector="Border.overlay TextBlock">
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Grid#Transport.disabled">
      <Setter Property="Opacity" Value="0.35" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.recent:pointerover">
      <Setter Property="Background" Value="{StaticResource SubtleHoverBrush}" />
    </Style>
    <Style Selector="Panel#DropZone.over Rectangle#DropBorder">
      <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
      <Setter Property="Fill" Value="#0D3B82F6" />
    </Style>
  </UserControl.Styles>
</UserControl>
