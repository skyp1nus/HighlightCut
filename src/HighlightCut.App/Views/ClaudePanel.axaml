<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HighlightCut.App.ViewModels"
             xmlns:c="using:HighlightCut.App.Controls"
             xmlns:v="using:HighlightCut.App.Views"
             x:Class="HighlightCut.App.Views.ClaudePanel"
             x:DataType="vm:ClaudePanelViewModel">
  <!-- Collapsible log of Claude's edits: 38 px header (+1 px top hairline), at most 300 px open. -->
  <Border Name="Root" Background="{StaticResource PanelDeepBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
          MaxHeight="300" Classes.open="{Binding IsOpen}">
    <Grid RowDefinitions="38,*">
      <Border Name="Header" Background="Transparent" Padding="14,0,12,0" Cursor="Hand" PointerPressed="OnHeaderPressed">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
          <c:SvgIcon Name="Chevron" Data="{StaticResource IconChevron12}" ViewBox="12" StrokeWidth="1.2" Width="12" Height="12"
                     Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="Claude" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextBrush}"
                     Margin="8,0,0,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="via MCP" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <c:PulseDot Width="6" Height="6" Fill="{StaticResource TextBrush}" IsVisible="{Binding IsStatusLive}" VerticalAlignment="Center" />
            <TextBlock Name="StatusLine" Text="{Binding StatusLine}" FontSize="11" Classes.busy="{Binding IsStatusLive}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Name="LogScroller" Grid.Row="1" IsVisible="{Binding IsOpen}" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,2,12,6">
          <TextBlock IsVisible="{Binding HasNoCards}" Margin="2,8,2,10" Text="Claude’s timeline edits appear here, each with its own undo."
                     FontSize="11.5" LineHeight="17.25" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
          <v:ClaudeExportCard DataContext="{Binding Export}" />
          <!-- Newest on top: every card docks to the bottom of the one after it. -->
          <ItemsControl ItemsSource="{Binding Log}" VerticalAlignment="Top">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <DockPanel LastChildFill="False" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Styles>
              <Style Selector="ContentPresenter">
                <Setter Property="DockPanel.Dock" Value="Bottom" />
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ClaudeLogItemViewModel">
                <Border Classes="card" IsVisible="{Binding IsCard}" Classes.undone="{Binding IsUndone}" Classes.live="{Binding IsLive}"
                        Margin="0,0,0,6" Padding="12,10,10,10" CornerRadius="8.77" BorderThickness="1">
                  <Grid ColumnDefinitions="8,10,*,10,Auto">
                    <Panel VerticalAlignment="Top" Margin="0,5,0,0" Width="6" Height="6" HorizontalAlignment="Left">
                      <c:PulseDot Width="6" Height="6" Fill="{StaticResource TextBrush}" IsVisible="{Binding IsLive}" />
                      <Ellipse Classes="dot" Width="6" Height="6" IsVisible="{Binding !IsLive}" />
                    </Panel>
                    <StackPanel Grid.Column="2" Spacing="3">
                      <TextBlock Classes="title" Text="{Binding Text}" FontWeight="Medium" LetterSpacing="-0.2"
                                 Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Meta}" FontSize="11" LineHeight="16" Foreground="{StaticResource MutedBrush}"
                                 TextWrapping="Wrap" IsVisible="{Binding Meta, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Spacing="6" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding WhenText}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                      <Button Classes="soft" IsVisible="{Binding ShowUndo}" Height="22" Padding="8,0" CornerRadius="6" FontSize="11"
                              Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Right" Content="Undo"
                              ToolTip.Tip="Undo just this action" Command="{Binding UndoCommand}" />
                      <Button Classes="soft" IsVisible="{Binding IsLive}" Height="22" Padding="8,0" CornerRadius="6" FontSize="11"
                              Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Right" Content="Stop"
                              Command="{Binding $parent[UserControl].((vm:ClaudePanelViewModel)DataContext).StopCommand}" />
                      <TextBlock IsVisible="{Binding ShowUndone}" Text="Undone" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                 HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>

  <UserControl.Styles>
    <Style Selector="Border#Root:not(.open) c|SvgIcon#Chevron">
      <Setter Property="RenderTransform" Value="rotate(-90deg)" />
    </Style>
    <Style Selector="Border#Header:pointerover">
      <Setter Property="Background" Value="#06FFFFFF" />
    </Style>
    <Style Selector="TextBlock#StatusLine">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock#StatusLine.busy">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#06FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
    </Style>
    <Style Selector="Border.card.live">
      <Setter Property="BorderBrush" Value="#38FFFFFF" />
    </Style>
    <Style Selector="Border.card.undone">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Border.card Ellipse.dot">
      <Setter Property="Fill" Value="{StaticResource Muted3Brush}" />
    </Style>
    <Style Selector="Border.card.undone Ellipse.dot">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{StaticResource Muted3Brush}" />
      <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style Selector="Border.card.undone TextBlock.title">
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
  </UserControl.Styles>
</UserControl>
