<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HighlightCut.App.ViewModels"
             xmlns:c="using:HighlightCut.App.Controls"
             x:Class="HighlightCut.App.Views.StatusBar"
             x:DataType="vm:EditorViewModel">
  <!-- Media details and messages on the left, keyboard hints on the right. 24 px including the top hairline. -->
  <Border Height="24" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
          Padding="14,0">
    <Grid ColumnDefinitions="*,Auto">
      <!-- Left-aligned with a star column: the text trims only when space runs out, and the item follows it. -->
      <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
        <TextBlock Text="{Binding StatusLeft}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
        <!-- Transcription in progress: dot, "transcribing 34% · parakeet · GPU" and a small bar. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,16,0" VerticalAlignment="Center"
                    IsVisible="{Binding TranscriptPanel.IsStatusVisible}">
          <c:PulseDot Width="6" Height="6" Fill="{StaticResource Text2Brush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding TranscriptPanel.StatusText}" FontSize="10.5" Foreground="{StaticResource Text2Brush}"
                     VerticalAlignment="Center" />
          <ProgressBar Width="56" MinWidth="0" Height="3" MinHeight="3" CornerRadius="2" Minimum="0" Maximum="1"
                       Value="{Binding TranscriptPanel.Progress}" Background="{StaticResource FieldBrush}"
                       Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
        <StackPanel Classes="hint"><Border Classes="kbd status"><TextBlock Text="{Binding Settings.Keys.PlayPause}" /></Border><TextBlock Text="Play" /></StackPanel>
        <StackPanel Classes="hint"><Border Classes="kbd status"><TextBlock Text="{Binding Settings.Keys.InOut}" /></Border><TextBlock Text="In / out" /></StackPanel>
        <StackPanel Classes="hint"><Border Classes="kbd status"><TextBlock Text="{Binding Settings.Keys.FrameStep}" /></Border><TextBlock Text="Frame step" /></StackPanel>
        <StackPanel Classes="hint"><Border Classes="kbd status"><TextBlock Text="{Binding Settings.Keys.DeleteClip}" /></Border><TextBlock Text="Remove" /></StackPanel>
        <StackPanel Classes="hint"><Border Classes="kbd status"><TextBlock Text="{Binding Settings.Keys.Undo}" /></Border><TextBlock Text="Undo" /></StackPanel>
      </StackPanel>
    </Grid>
  </Border>

  <UserControl.Styles>
    <Style Selector="StackPanel.hint">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.hint > TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
</UserControl>
