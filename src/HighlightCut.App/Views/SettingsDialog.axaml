<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HighlightCut.App.ViewModels"
             xmlns:c="using:HighlightCut.App.Controls"
             xmlns:s="using:HighlightCut.App.Views.Settings"
             x:Class="HighlightCut.App.Views.SettingsDialog"
             x:DataType="vm:SettingsViewModel">
  <!-- 780 × 580: section list on the left, the chosen section (Views/Settings/*Section) on the right. -->
  <Border Background="{StaticResource ScrimBrush}">
    <Border Width="780" Height="580" CornerRadius="12" Background="{StaticResource DialogBrush}" ClipToBounds="True"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            BoxShadow="inset 0 1 0 0 #17FFFFFF, 0 0 0 1 #1AFFFFFF, 0 16 36 0 #66000000">
      <!-- The design's 188 px list is content-box: 208 with its padding. -->
      <Grid ColumnDefinitions="208,*">
        <Border Background="{StaticResource PanelDeepBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0"
                Padding="10,16">
          <StackPanel Spacing="2">
            <TextBlock Text="Settings" FontSize="14" FontWeight="Medium" LetterSpacing="-0.3" Foreground="{StaticResource TextBrush}"
                       Margin="8,0,8,12" />
            <ItemsControl ItemsSource="{Binding SectionOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChoiceOption">
                  <Button Classes="nav" Classes.on="{Binding IsSelected}" Content="{Binding Label}" Command="{Binding PickCommand}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*,52">
          <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="24,18,16,14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Section}" FontSize="14" FontWeight="Medium" LetterSpacing="-0.3" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="{Binding SectionNote}" FontSize="12" LineHeight="17.4" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="ghost bright" Width="26" Height="26" CornerRadius="6" VerticalAlignment="Top"
                      Foreground="{StaticResource Text4Brush}" ToolTip.Tip="Close (Esc)" Command="{Binding CloseCommand}">
                <c:SvgIcon Data="{StaticResource IconClose10}" ViewBox="10" StrokeWidth="1.2" LineCap="Flat" Width="10" Height="10" />
              </Button>
            </Grid>
          </Border>

          <!-- One scroller for every section; it goes back to the top when the section changes. -->
          <ScrollViewer Name="Scroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <Panel Margin="24,8,24,20">
              <s:GeneralSection IsVisible="{Binding IsGeneral}" />
              <s:PlaybackSection IsVisible="{Binding IsPlayback}" />
              <s:ExportSection IsVisible="{Binding IsExport}" />
              <s:TranscriptionSection IsVisible="{Binding IsTranscription}" />
              <s:KeyboardSection IsVisible="{Binding IsKeyboard}" />
              <s:McpSection IsVisible="{Binding IsMcp}" />
            </Panel>
          </ScrollViewer>

          <Border Grid.Row="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,0,16,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Changes save automatically" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="soft" Height="30" Padding="14,0" CornerRadius="10" FontSize="12.5" Content="Done"
                      VerticalAlignment="Center" Command="{Binding CloseCommand}" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Border>

  <UserControl.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
    </Style>
    <Style Selector="Button.nav.on">
      <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
      <Setter Property="BorderBrush" Value="#D93B82F6" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="BorderBrush" Value="{StaticResource DividerSoftBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.row.last">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.row TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Label of a row whose control is taller than one line (control, then help text). -->
    <Style Selector="Border.row TextBlock.label.top">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,16,0,0" />
    </Style>
    <Style Selector="TextBlock.colhead">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LetterSpacing" Value="0.2" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
</UserControl>
