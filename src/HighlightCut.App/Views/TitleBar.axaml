<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HighlightCut.App.ViewModels"
             xmlns:c="using:HighlightCut.App.Controls"
             x:Class="HighlightCut.App.Views.TitleBar"
             x:DataType="vm:EditorViewModel">
  <!-- 48 px including the hairline at the bottom. Empty areas drag the window. -->
  <Border Name="Bar" Height="48" Background="{StaticResource ChromeBrush}"
          BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
          WindowDecorationProperties.ElementRole="TitleBar">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,0,0,0">
        <!-- Logo: a square with a cut through it. -->
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Panel Width="12" Height="12" VerticalAlignment="Center">
            <Border CornerRadius="3" BorderThickness="1.5" BorderBrush="{StaticResource BoneBrush}" />
            <Border Width="1.5" Height="18" Margin="3,-3,0,-3" HorizontalAlignment="Left" Background="{StaticResource ChromeBrush}" />
          </Panel>
          <TextBlock Text="HighlightCut" FontSize="13" FontWeight="Medium" LetterSpacing="-0.3"
                     Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <Border Width="1" Height="20" Background="#1FFFFFFF" VerticalAlignment="Center" />

        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" WindowDecorationProperties.ElementRole="User">
          <Button Name="OpenButton" Classes="soft" Height="28" Padding="10,0,8,0" ToolTip.Tip="Open a video (Ctrl+O)"
                  Command="{Binding OpenFileCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:SvgIcon Data="{StaticResource IconOpen16}" ViewBox="16" StrokeWidth="1.2" LineJoin="Miter" Width="14" Height="14"
                         VerticalAlignment="Center" />
              <TextBlock Text="Open file" VerticalAlignment="Center" />
              <Border Classes="kbd"><TextBlock Text="{Binding Settings.Keys.OpenVideo}" /></Border>
            </StackPanel>
          </Button>
          <!-- Projects, save and export: the menus the design leaves out. -->
          <Button Name="FileMenuButton" Classes="ghost bright" Width="20" Height="28" Foreground="{StaticResource MutedBrush}"
                  ToolTip.Tip="Project">
            <c:SvgIcon Data="{StaticResource IconChevron12}" ViewBox="12" StrokeWidth="1.2" Width="12" Height="12" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Open video…" InputGesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
                <MenuItem Header="Open project…" InputGesture="Ctrl+Shift+O" Command="{Binding OpenProjectCommand}" />
                <MenuItem Header="Save project" InputGesture="Ctrl+S" Command="{Binding SaveProjectCommand}" IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Save project as…" InputGesture="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}" IsEnabled="{Binding HasFile}" />
                <Separator />
                <MenuItem Header="Undo" InputGesture="Ctrl+Z" Command="{Binding UndoCommand}" />
                <MenuItem Header="Redo" InputGesture="Ctrl+Y" Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem Header="Export…" InputGesture="Ctrl+E" Command="{Binding Export.OpenCommand}" IsEnabled="{Binding HasFile}" />
                <MenuItem Header="Settings…" Command="{Binding Settings.OpenCommand}" />
                <MenuItem Header="Welcome tour" Command="{Binding Tour.OpenCommand}" />
                <MenuItem Header="What’s new" Command="{Binding WhatsNew.ShowCommand}" />
                <Separator />
                <MenuItem Header="Exit" Click="OnExit" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Project" Foreground="{StaticResource MutedBrush}" />
          <TextBlock Text="/" Foreground="{StaticResource MutedBrush}" />
          <TextBlock Text="{Binding ProjectTitle}" Foreground="{StaticResource Text2Brush}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
        <!-- MCP status: green while Claude is connected or editing, neutral otherwise. -->
        <Border Name="McpBadge" Height="22" Padding="8,0" CornerRadius="5.26" BorderThickness="1" VerticalAlignment="Center"
                Classes.on="{Binding Claude.IsMcpOn}"
                ToolTip.Tip="How to connect Claude: Settings → MCP server">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Name="McpDot" Width="5" Height="5" VerticalAlignment="Center" />
            <TextBlock Name="McpLabel" Text="{Binding McpText}" FontSize="10.5" FontWeight="Medium" LetterSpacing="0"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <Button Classes="ghost bright" Width="30" Height="28" VerticalAlignment="Center" Foreground="{StaticResource Text4Brush}"
                ToolTip.Tip="Settings" Command="{Binding Settings.OpenCommand}" WindowDecorationProperties.ElementRole="User">
          <Panel Width="16" Height="16">
            <c:SvgIcon Data="{StaticResource IconGearHub16}" ViewBox="16" StrokeWidth="1.2" />
            <c:SvgIcon Data="{StaticResource IconGearTeeth16}" ViewBox="16" StrokeWidth="2" LineCap="Flat" />
          </Panel>
        </Button>

        <!-- "Exporting 45%" with a 2 px strip while an export runs; it reopens the dialog on it. -->
        <Button Name="ExportPill" Classes="bone" Height="28" Padding="0" VerticalAlignment="Center" VerticalContentAlignment="Stretch"
                HorizontalContentAlignment="Stretch" ToolTip.Tip="Export (Ctrl+E)" IsEnabled="{Binding CanExport}"
                Command="{Binding Export.OpenCommand}" WindowDecorationProperties.ElementRole="User">
          <Border CornerRadius="10" ClipToBounds="True">
            <Panel>
              <TextBlock Text="{Binding ExportButtonText}" Margin="16,0" VerticalAlignment="Center" />
              <ProgressBar IsVisible="{Binding Export.IsInProgress}" Minimum="0" Maximum="1" Value="{Binding Export.Progress}"
                           Height="2" MinHeight="2" MinWidth="0" CornerRadius="0" VerticalAlignment="Bottom"
                           Background="Transparent" Foreground="#73333333" />
            </Panel>
          </Border>
        </Button>

        <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
          <Button Classes="caption" Click="OnMinimize" WindowDecorationProperties.ElementRole="MinimizeButton">
            <c:SvgIcon Data="{StaticResource IconMinimize10}" ViewBox="10" StrokeWidth="1" LineCap="Flat" Width="10" Height="10" />
          </Button>
          <Button Classes="caption" Click="OnMaximize" WindowDecorationProperties.ElementRole="MaximizeButton">
            <c:SvgIcon Data="{StaticResource IconMaximize10}" ViewBox="10" StrokeWidth="1" LineCap="Flat" Width="10" Height="10" />
          </Button>
          <Button Classes="caption close" Click="OnClose" WindowDecorationProperties.ElementRole="CloseButton">
            <c:SvgIcon Data="{StaticResource IconCloseWindow10}" ViewBox="10" StrokeWidth="1" LineCap="Flat" Width="10" Height="10" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>

  <UserControl.Styles>
    <Style Selector="Border#McpBadge">
      <Setter Property="BorderBrush" Value="{StaticResource KbdBorderBrush}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border#McpBadge Ellipse#McpDot">
      <Setter Property="Fill" Value="{StaticResource StatusOffBrush}" />
    </Style>
    <Style Selector="Border#McpBadge TextBlock#McpLabel">
      <Setter Property="Foreground" Value="{StaticResource Text4Brush}" />
    </Style>
    <Style Selector="Border#McpBadge.on">
      <Setter Property="BorderBrush" Value="#8C4ADE80" />
      <Setter Property="Background" Value="#0F4ADE80" />
    </Style>
    <Style Selector="Border#McpBadge.on Ellipse#McpDot">
      <Setter Property="Fill" Value="{StaticResource StatusOnBrush}" />
      <Setter Property="Effect" Value="drop-shadow(0 0 4 #8C22C55E)" />
    </Style>
    <Style Selector="Border#McpBadge.on TextBlock#McpLabel">
      <Setter Property="Foreground" Value="{StaticResource StatusOnBrush}" />
    </Style>
  </UserControl.Styles>
</UserControl>
