<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HighlightCut.App.ViewModels"
             xmlns:c="using:HighlightCut.App.Controls"
             xmlns:v="using:HighlightCut.App.Views"
             x:Class="HighlightCut.App.Views.TranscriptPanel"
             x:DataType="vm:TranscriptPanelViewModel">
  <UserControl.Resources>
    <!-- CSS text-underline-offset 3px counts from the baseline. -->
    <TextDecorationCollection x:Key="FillerUnderline">
      <TextDecoration Location="Baseline" Stroke="#73FFFFFF" StrokeThickness="1" StrokeThicknessUnit="Pixel"
                      StrokeDashArray="1,1" StrokeOffset="3" StrokeOffsetUnit="Pixel" />
    </TextDecorationCollection>
    <TextDecorationCollection x:Key="OutStrike">
      <TextDecoration Location="Strikethrough" Stroke="#E671717A" StrokeThickness="1" StrokeThicknessUnit="Pixel" />
    </TextDecorationCollection>
  </UserControl.Resources>

  <Panel>
    <!-- The text: search row, paragraphs of words, and the selection bar. -->
    <Grid RowDefinitions="44,*,Auto" IsVisible="{Binding HasText}">
      <Border BorderBrush="{StaticResource DividerSoftBrush}" BorderThickness="0,0,0,1" Padding="12,0,10,0">
        <Grid ColumnDefinitions="*,6,Auto,6,Auto,6,Auto" VerticalAlignment="Center">
          <Panel>
            <TextBox Name="SearchBox" Classes="search transcript" Text="{Binding Query}" PlaceholderText="Search transcript" />
            <c:SvgIcon Data="{StaticResource IconSearch12}" ViewBox="12" StrokeWidth="1.2" Width="12" Height="12" Margin="9,0,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False" />
          </Panel>
          <TextBlock Grid.Column="2" Classes="mono" Text="{Binding MatchText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                     MinWidth="48" TextAlignment="Right" VerticalAlignment="Center" />
          <Button Grid.Column="4" Classes="soft match" ToolTip.Tip="Previous match (Shift Enter)" Command="{Binding PreviousMatchCommand}">
            <c:SvgIcon Data="{StaticResource IconChevronUp10}" ViewBox="10" StrokeWidth="1.2" Width="10" Height="10" />
          </Button>
          <Button Grid.Column="6" Classes="soft match" ToolTip.Tip="Next match (Enter)" Command="{Binding NextMatchCommand}">
            <c:SvgIcon Data="{StaticResource IconChevronDown10}" ViewBox="10" StrokeWidth="1.2" Width="10" Height="10" />
          </Button>
        </Grid>
      </Border>

      <ScrollViewer Name="Scroller" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,6,0,12">
          <ItemsControl Name="ParagraphList" ItemsSource="{Binding Paragraphs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TranscriptParagraphViewModel">
                <StackPanel>
                <!-- With several videos: a thin rule and the video's name where its words begin. -->
                <Grid ColumnDefinitions="Auto,8,*" Margin="12,10,14,2" IsVisible="{Binding HasVideo}">
                  <TextBlock Text="{Binding Video}" FontSize="10.5" FontWeight="Medium" Foreground="{StaticResource Text4Brush}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                  <Border Grid.Column="2" Height="1" Background="{StaticResource DividerBrush}" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="40,10,*" Margin="12,6,14,6">
                  <Button Classes="stamp" ToolTip.Tip="Move the playhead here" Command="{Binding SeekCommand}">
                    <TextBlock Classes="mono" Text="{Binding TimeText}" FontSize="10.5" />
                  </Button>
                  <ItemsControl Grid.Column="2" ItemsSource="{Binding Words}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TranscriptWordViewModel">
                        <Border Classes="word" Classes.filler="{Binding IsFiller}" Classes.out="{Binding IsOut}"
                                Classes.match="{Binding IsMatch}" Classes.curmatch="{Binding IsCurrentMatch}"
                                Classes.cur="{Binding IsCurrent}" Classes.sel="{Binding IsSelected}">
                          <TextBlock Text="{Binding Text}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="62,8,14,8" IsVisible="{Binding IsRunning}">
            <c:PulseDot Width="6" Height="6" Fill="{StaticResource Text2Brush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TailText}" FontSize="11.5" Foreground="{StaticResource Text4Brush}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="No speech found in this video." Margin="20,22" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                     IsVisible="{Binding IsEmptyTranscript}" />
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Background="{StaticResource PanelDeepBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
              Padding="12,10" IsVisible="{Binding HasSelection}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,8,Auto,*,Auto">
            <TextBlock Text="Selection" FontSize="11.5" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="mono" Text="{Binding SelectionText}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="4" Classes="ghost bright" Width="20" Height="20" CornerRadius="5" Foreground="{StaticResource MutedBrush}"
                    ToolTip.Tip="Clear selection" Command="{Binding ClearSelectionCommand}">
              <c:SvgIcon Data="{StaticResource IconClose10}" ViewBox="10" StrokeWidth="1.2" LineCap="Flat" Width="9" Height="9" />
            </Button>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="soft action" Content="Keep as clip" Command="{Binding KeepSelectionCommand}" />
            <Button Classes="soft action" Content="Cut out" Command="{Binding CutSelectionCommand}" />
            <Button Classes="soft action" Content="Play selection" Command="{Binding PlaySelectionCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- No model: download Parakeet here, or pick another in Settings. -->
    <StackPanel Classes="note" IsVisible="{Binding IsNoModel}">
      <TextBlock Classes="title" Text="No transcription model" />
      <TextBlock Classes="body"
                 Text="Transcription runs on this computer. Install a model to get the text of this video with a timestamp for every word, and to let Claude cut by words." />
      <StackPanel Spacing="10" IsVisible="{Binding ModelOffer.ShowOffer}">
        <Button Classes="soft big" Content="{Binding ModelOffer.DownloadButtonText}" Command="{Binding DownloadModelCommand}"
                IsVisible="{Binding ModelOffer.ShowDownloadButton}" IsEnabled="{Binding SuggestedModel.CanManage, FallbackValue=False}" />
        <TextBlock Text="{Binding ModelOffer.Note}" IsVisible="{Binding ModelOffer.ShowNote}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
      <Panel Margin="0,4,0,0" IsVisible="{Binding ModelOffer.IsDownloading}">
        <v:ModelDownloadProgress DataContext="{Binding ModelOffer}" />
      </Panel>
      <Button Classes="link" HorizontalAlignment="Left" FontSize="11.5" Content="Other models in Settings → Transcription"
              Command="{Binding OpenModelSettingsCommand}" />
    </StackPanel>

    <!-- Not transcribed yet, or it failed (not in the design; same layout as the no-model note). -->
    <StackPanel Classes="note" IsVisible="{Binding IsNotStarted}">
      <TextBlock Classes="title" Text="Not transcribed yet" />
      <TextBlock Classes="body"
                 Text="Transcribe this video to get its text with a timestamp for every word, and to let Claude cut by words." />
      <Button Classes="soft big" Content="Transcribe" Command="{Binding TranscribeCommand}" />
    </StackPanel>
    <StackPanel Classes="note" IsVisible="{Binding IsFailed}">
      <TextBlock Classes="title" Text="Transcription failed" />
      <TextBlock Classes="body" Text="{Binding ErrorText}" />
      <Button Classes="soft big" Content="Try again" Command="{Binding TranscribeCommand}" />
    </StackPanel>

    <TextBlock Text="Open a video to see its transcript." Margin="20,28" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
               IsVisible="{Binding IsNoVideo}" />
  </Panel>

  <UserControl.Styles>
    <Style Selector="TextBox.transcript">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="28,0,8,0" />
      <Setter Property="PlaceholderForeground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style Selector="Button.match">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
    </Style>
    <Style Selector="Button.match:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="Button.stamp">
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="0,1,0,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="Button.stamp:pointerover">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <!-- Words: later rules win, as in the prototype (current over out over filler; selected on top). -->
    <!-- The design's 1.5 px padding and 2.5 px gap, in whole pixels: layout rounding would widen them. -->
    <Style Selector="Border.word">
      <Setter Property="Padding" Value="1" />
      <Setter Property="Margin" Value="0,1,3,1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.word > TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
    </Style>
    <Style Selector="Border.word.filler > TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text4Brush}" />
      <Setter Property="TextDecorations" Value="{StaticResource FillerUnderline}" />
    </Style>
    <Style Selector="Border.word.out > TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted3Brush}" />
      <Setter Property="TextDecorations" Value="{StaticResource OutStrike}" />
    </Style>
    <Style Selector="Border.word.match">
      <Setter Property="BoxShadow" Value="inset 0 0 0 1 #59FFFFFF" />
    </Style>
    <Style Selector="Border.word.curmatch">
      <Setter Property="Background" Value="#24FFFFFF" />
      <Setter Property="BoxShadow" Value="inset 0 0 0 1 #99FFFFFF" />
    </Style>
    <Style Selector="Border.word.cur">
      <Setter Property="Background" Value="#1AFFFFFF" />
      <Setter Property="BoxShadow" Value="inset 0 -1.5 0 0 #3B82F6" />
    </Style>
    <Style Selector="Border.word.cur > TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="Border.word.sel">
      <Setter Property="Background" Value="#3D3B82F6" />
    </Style>

    <Style Selector="Button.action">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>

    <!-- The no-model, not-started and failed notes. -->
    <Style Selector="StackPanel.note">
      <Setter Property="Margin" Value="20,28" />
      <Setter Property="Spacing" Value="10" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="StackPanel.note > TextBlock.title">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="StackPanel.note > TextBlock.body">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="LineHeight" Value="17.25" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.big">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </UserControl.Styles>
</UserControl>
