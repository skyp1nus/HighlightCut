<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HighlightCut.App.ViewModels"
             xmlns:c="using:HighlightCut.App.Controls"
             xmlns:ex="using:HighlightCut.Media.Export"
             x:Class="HighlightCut.App.Views.ExportDialog"
             x:DataType="vm:ExportViewModel">
  <!-- Mode, output and destination; the progress card appears in place once the export starts. -->
  <Border Background="{StaticResource ScrimBrush}">
    <Border Width="540" CornerRadius="12" Background="{StaticResource DialogBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
            BoxShadow="inset 0 1 0 0 #17FFFFFF, 0 0 0 1 #1AFFFFFF, 0 16 36 0 #66000000">
      <StackPanel>
        <!-- Header -->
        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,16,16,14">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto">
            <TextBlock Text="Export" FontSize="14" FontWeight="Medium" LetterSpacing="-0.3" Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding HeaderSummary}" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"
                       VerticalAlignment="Center" />
            <Button Grid.Column="3" Classes="ghost bright" Width="26" Height="26" CornerRadius="6" Foreground="{StaticResource Text4Brush}"
                    ToolTip.Tip="Close (Esc)" Command="{Binding DismissCommand}">
              <c:SvgIcon Data="{StaticResource IconClose10}" ViewBox="10" StrokeWidth="1.2" LineCap="Flat" Width="10" Height="10" />
            </Button>
          </Grid>
        </Border>

        <!-- Options (dimmed while exporting) -->
        <StackPanel Name="Options" Margin="20,18" Spacing="18" Classes.locked="{Binding !IsConfiguring}">
          <StackPanel Spacing="8">
            <TextBlock Classes="field" Text="Mode" />
            <ItemsControl ItemsSource="{Binding ModeCards}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" ColumnSpacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ExportModeOption">
                  <Button Classes="mode" Classes.sel="{Binding IsSelected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Padding="12,10" CornerRadius="8.77" BorderThickness="1" Command="{Binding PickCommand}">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding CardTitle}" FontSize="12.5" FontWeight="Normal" Foreground="{StaticResource TextBrush}" />
                      <TextBlock Text="{Binding CardDescription}" FontSize="11" FontWeight="Normal" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock IsVisible="{Binding ShowSnapNote}" Text="{Binding SnapNote}" FontSize="11" LineHeight="16.5"
                       Foreground="{StaticResource Text4Brush}" TextWrapping="Wrap" />
            <!-- Videos that stream copy cannot join: why, and re-encoding offered. -->
            <StackPanel Name="LosslessProblem" IsVisible="{Binding HasLosslessProblem}" Spacing="4">
              <TextBlock Text="{Binding LosslessProblem}" FontSize="11" LineHeight="16.5" Foreground="{StaticResource DangerBrush}"
                         TextWrapping="Wrap" />
              <Button Classes="link" FontSize="11" HorizontalAlignment="Left" Content="Re-encode instead"
                      Command="{Binding UseReencodeCommand}" />
            </StackPanel>
            <Grid IsVisible="{Binding IsEncode}" ColumnDefinitions="*,8,*">
              <ComboBox Classes="field small" HorizontalAlignment="Stretch" ItemsSource="{x:Static ex:VideoEncoding.All}"
                        SelectedItem="{Binding Video}" ToolTip.Tip="Video">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="ex:VideoEncoding">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox Grid.Column="2" Classes="field small" HorizontalAlignment="Stretch" ItemsSource="{Binding AudioChoices}"
                        SelectedItem="{Binding Audio}" ToolTip.Tip="Audio">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AudioChoice">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Classes="field" Text="Output" />
            <Border Classes="segs">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="seg" Classes.on="{Binding Outputs[0].IsSelected}" Height="26" Padding="12,0"
                        Content="Merge into one file" Command="{Binding Outputs[0].PickCommand}" />
                <Button Classes="seg" Classes.on="{Binding Outputs[1].IsSelected}" Height="26" Padding="12,0"
                        Content="{Binding SeparateFilesText}" Command="{Binding Outputs[1].PickCommand}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Classes="field" Text="Save to" />
            <Grid ColumnDefinitions="*,8,Auto">
              <Border Classes="field" ToolTip.Tip="{Binding OutputFolder}">
                <TextBlock Text="{Binding OutputFolder}" />
              </Border>
              <Button Grid.Column="2" Classes="soft" Height="30" Padding="12,0" Content="Browse" Command="{Binding BrowseCommand}" />
            </Grid>
            <TextBlock Classes="mono" Text="{Binding FileNamesText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <!-- Everything the design leaves out, folded away. -->
          <StackPanel Spacing="10">
            <Button Classes="link" HorizontalAlignment="Left" FontSize="11.5" Command="{Binding ToggleMoreOptionsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <c:SvgIcon Name="MoreChevron" Data="{StaticResource IconChevron12}" ViewBox="12" StrokeWidth="1.2" Width="12" Height="12"
                           Classes.open="{Binding ShowMoreOptions}" VerticalAlignment="Center" />
                <TextBlock Text="More options" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel IsVisible="{Binding ShowMoreOptions}" Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Classes="field" Text="Container" VerticalAlignment="Center" />
                <Border Classes="segs">
                  <ItemsControl ItemsSource="{Binding Containers}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="2" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ChoiceOption">
                        <Button Classes="seg" Classes.on="{Binding IsSelected}" Height="24" Padding="10,0" Command="{Binding PickCommand}">
                          <TextBlock Classes="mono" Text="{Binding Label}" FontSize="11" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>
              <CheckBox Classes="small" Content="Add chapter markers from clip labels" IsChecked="{Binding AddChapters}"
                        IsEnabled="{Binding CanAddChapters}" />
              <CheckBox Classes="small" Content="Keep all audio and subtitle tracks" IsChecked="{Binding KeepAllTracks}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- Progress -->
        <Border IsVisible="{Binding !IsConfiguring}" Margin="20,0,20,18" Padding="14" CornerRadius="8.77"
                Background="{StaticResource PanelDeepBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                Name="ProgressCard" Classes.done="{Binding IsDone}" Classes.failed="{Binding HasError}">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Panel Width="6" Height="6" VerticalAlignment="Center">
                  <c:PulseDot Width="6" Height="6" Fill="{StaticResource TextBrush}" IsVisible="{Binding IsRunning}" />
                  <Ellipse Name="DoneDot" Width="6" Height="6" IsVisible="{Binding !IsRunning}" />
                </Panel>
                <TextBlock Name="ProgressTitle" Text="{Binding ProgressText}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Grid.Column="2" Classes="mono" Text="{Binding PercentText}" FontSize="11.5" FontWeight="Medium"
                         Foreground="{StaticResource TextBrush}" />
            </Grid>
            <ProgressBar Name="Bar" MinWidth="0" Minimum="0" Maximum="1" Value="{Binding Progress}" Height="4" MinHeight="4" CornerRadius="2"
                         Background="{StaticResource FieldBrush}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding ProgressDetail}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
              <Button Grid.Column="1" Classes="link" FontSize="11" IsVisible="{Binding IsDone}" Content="Show in folder"
                      Command="{Binding RevealCommand}" Margin="12,0,0,0" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Footer -->
        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,14,16,16">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding EstimateLine}" IsVisible="{Binding !IsAskingAboutExisting}" FontSize="11.5"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <!-- Settings → Export → If the file exists: Ask. -->
            <TextBlock Name="ExistingQuestion" Text="{Binding ExistingFilesText}" IsVisible="{Binding IsAskingAboutExisting}" FontSize="11.5"
                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding ExistingFilesText}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Classes="soft" IsVisible="{Binding IsConfiguring}" Height="30" Padding="14,0" CornerRadius="10" FontSize="12.5"
                      Content="Cancel" Command="{Binding CloseCommand}" />
              <Button Classes="soft" IsVisible="{Binding IsAskingAboutExisting}" Height="30" Padding="14,0" CornerRadius="10" FontSize="12.5"
                      Content="Add a number" Command="{Binding AddNumberCommand}" />
              <Button Classes="bone" IsVisible="{Binding IsAskingAboutExisting}" Height="30" Padding="18,0" Content="Overwrite"
                      Command="{Binding OverwriteCommand}" />
              <Button Classes="bone" IsVisible="{Binding ShowExportButton}" Height="30" Padding="18,0" Content="Export"
                      ToolTip.Tip="Export (Enter)" Command="{Binding StartCommand}" IsEnabled="{Binding !HasLosslessProblem}" />
              <Button Classes="soft risky" Height="30" Padding="14,0" CornerRadius="10" FontSize="12.5"
                      Content="Cancel export" Command="{Binding CancelExportCommand}">
                <Button.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsRunning" />
                    <Binding Path="IsExporting" />
                  </MultiBinding>
                </Button.IsVisible>
              </Button>
              <Button Classes="soft" Height="30" Padding="14,0" CornerRadius="10" FontSize="12.5" Content="Close"
                      Command="{Binding CloseCommand}">
                <Button.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="!IsRunning" />
                    <Binding Path="IsExporting" />
                  </MultiBinding>
                </Button.IsVisible>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
  </Border>

  <UserControl.Styles>
    <Style Selector="TextBlock.field">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="StackPanel#Options.locked">
      <Setter Property="Opacity" Value="0.45" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.mode">
      <Setter Property="Background" Value="#06FFFFFF" />
      <Setter Property="BorderBrush" Value="#14FFFFFF" />
    </Style>
    <Style Selector="Button.mode:pointerover">
      <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    </Style>
    <Style Selector="Button.mode.sel">
      <Setter Property="Background" Value="{StaticResource ControlBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="c|SvgIcon#MoreChevron">
      <Setter Property="RenderTransform" Value="rotate(-90deg)" />
    </Style>
    <Style Selector="c|SvgIcon#MoreChevron.open">
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="TextBlock#ProgressTitle">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="Border#ProgressCard.done TextBlock#ProgressTitle">
      <Setter Property="Foreground" Value="{StaticResource StatusOnBrush}" />
    </Style>
    <Style Selector="Border#ProgressCard.failed TextBlock#ProgressTitle">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>
    <Style Selector="Border#ProgressCard.done Ellipse#DoneDot">
      <Setter Property="Fill" Value="{StaticResource StatusOnBrush}" />
      <Setter Property="Effect" Value="drop-shadow(0 0 4 #8C22C55E)" />
    </Style>
    <Style Selector="Border#ProgressCard.failed Ellipse#DoneDot">
      <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
    </Style>
    <Style Selector="ProgressBar#Bar">
      <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
    </Style>
    <Style Selector="Border#ProgressCard.done ProgressBar#Bar">
      <Setter Property="Foreground" Value="{StaticResource StatusOnBrush}" />
    </Style>
    <Style Selector="Border#ProgressCard.failed ProgressBar#Bar">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>
  </UserControl.Styles>
</UserControl>
