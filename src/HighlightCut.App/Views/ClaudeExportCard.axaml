<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HighlightCut.App.ViewModels"
             xmlns:c="using:HighlightCut.App.Controls"
             x:Class="HighlightCut.App.Views.ClaudeExportCard"
             x:DataType="vm:ClaudeExportViewModel">
  <!-- Claude's export, on top of the log; Border.card comes from ClaudePanel. -->
  <Border Classes="card" Classes.live="{Binding IsLive}" IsVisible="{Binding HasCard}" Margin="0,0,0,6" Padding="12,10,10,10"
          CornerRadius="8.77" BorderThickness="1">
    <Grid ColumnDefinitions="8,10,*,10,Auto">
      <Panel VerticalAlignment="Top" Margin="0,5,0,0" Width="6" Height="6" HorizontalAlignment="Left">
        <c:PulseDot Width="6" Height="6" Fill="{StaticResource TextBrush}" IsVisible="{Binding IsLive}" />
        <Ellipse Classes="xdot" Classes.done="{Binding IsDone}" Classes.failed="{Binding IsFailed}" Classes.ended="{Binding IsEnded}"
                 Width="6" Height="6" IsVisible="{Binding !IsLive}" />
      </Panel>
      <StackPanel Grid.Column="2" Spacing="3">
        <TextBlock Name="Title" Text="{Binding Title}" FontWeight="Medium" LetterSpacing="-0.2" Foreground="{StaticResource TextBrush}"
                   TextWrapping="Wrap" />
        <TextBlock Name="Detail" Text="{Binding Detail}" FontSize="11" LineHeight="16" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" />
        <ProgressBar IsVisible="{Binding ShowProgress}" Minimum="0" Maximum="1" Value="{Binding Progress}" Height="3" MinHeight="3"
                     MinWidth="0" CornerRadius="2" Margin="0,5,0,0" Background="{StaticResource FieldBrush}"
                     Foreground="{StaticResource Text2Brush}" />
      </StackPanel>
      <StackPanel Grid.Column="4" Spacing="6" HorizontalAlignment="Right">
        <TextBlock Text="{Binding WhenText}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
        <Button Classes="soft" IsVisible="{Binding CanCancel}" Height="22" Padding="8,0" CornerRadius="6" FontSize="11"
                Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Right" Content="Cancel" Command="{Binding CancelCommand}" />
        <Button Classes="soft" IsVisible="{Binding CanReveal}" Height="22" Padding="8,0" CornerRadius="6" FontSize="11"
                Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Right" Content="Show in folder" Command="{Binding RevealCommand}" />
        <Button Classes="soft" IsVisible="{Binding CanRetry}" Height="22" Padding="8,0" CornerRadius="6" FontSize="11"
                Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Right" Content="Retry" Command="{Binding RetryCommand}" />
      </StackPanel>
    </Grid>
  </Border>

  <UserControl.Styles>
    <Style Selector="Ellipse.xdot.done">
      <Setter Property="Fill" Value="{StaticResource StatusOnBrush}" />
      <Setter Property="Effect" Value="drop-shadow(0 0 4 #8C22C55E)" />
    </Style>
    <Style Selector="Ellipse.xdot.failed">
      <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
    </Style>
    <Style Selector="Ellipse.xdot.ended">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{StaticResource Muted3Brush}" />
      <Setter Property="StrokeThickness" Value="1" />
    </Style>
  </UserControl.Styles>
</UserControl>
