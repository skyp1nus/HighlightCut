<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Measures the app's memory through a realistic session: see README.md. Not part of the app; it hosts the real editor,
    player and analyses headlessly. It has the App's runtime settings (the defaults); keep them the same.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>HighlightCut.MemoryBench</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HighlightCut.App\HighlightCut.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>
</Project>
